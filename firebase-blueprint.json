{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the system (Doctor or Consultant)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["doctor", "consultant", "admin", "ceo", "theatre", "cmo"] },
        "clinicType": { "type": "string", "description": "For consultants: Pediatrics, Neuro, ENT, Surgical, Orthopedic, Gynae/Obs, MOPC" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Patient record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "diagnosis": { "type": "string" }
      },
      "required": ["id", "name", "diagnosis"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Clinic booking record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "diagnosis": { "type": "string" },
        "clinicType": { "type": "string" },
        "reviewDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "attended", "no-show"] },
        "bookedBy": { "type": "string" },
        "bookedByName": { "type": "string" },
        "bookedByEmail": { "type": "string", "format": "email" },
        "bookedAt": { "type": "string", "format": "date-time" },
        "comments": { "type": "string" }
      },
      "required": ["id", "patientId", "clinicType", "reviewDate", "status", "bookedByEmail"]
    },
    "WhitelistedEmail": {
      "title": "Whitelisted Email",
      "description": "An email address pre-approved for a specific role",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["doctor", "consultant", "admin", "ceo", "theatre", "cmo"] },
        "clinicType": { "type": "string", "description": "For consultants: Pediatrics, Neuro, ENT, Surgical, Orthopedic, Gynae/Obs, MOPC" },
        "addedAt": { "type": "string", "format": "date-time" },
        "addedBy": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "MarketingMessage": {
      "title": "Marketing Message",
      "description": "A broadcast message sent to patients for marketing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" },
        "sentBy": { "type": "string" },
        "sentByName": { "type": "string" },
        "targetClinic": { "type": "string" }
      },
      "required": ["content", "sentAt", "sentBy"]
    },
    "SurgicalCase": {
      "title": "Surgical Case",
      "description": "A record of a surgery performed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientName": { "type": "string" },
        "patientNumber": { "type": "string" },
        "diagnosis": { "type": "string" },
        "procedure": { "type": "string" },
        "department": { "type": "string", "enum": ["General Surgery", "Orthopedic", "Urology", "ENT", "Neurosurgery", "Plastic Surgery", "Ophthalmology", "OGD/Colonoscopy"] },
        "surgeon": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "recordedBy": { "type": "string" },
        "recordedByName": { "type": "string" },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientName", "patientNumber", "diagnosis", "procedure", "department", "surgeon", "date"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient records"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Clinic bookings"
    },
    "/whitelisted_emails/{email}": {
      "schema": "WhitelistedEmail",
      "description": "Emails allowed to register/login"
    },
    "/marketing_messages/{messageId}": {
      "schema": "MarketingMessage",
      "description": "History of marketing messages sent"
    },
    "/surgical_cases/{caseId}": {
      "schema": "SurgicalCase",
      "description": "Surgical case records"
    }
  }
}
