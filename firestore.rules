rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: uid
    // Fields:
    //   - uid: string (required)
    //   - name: string (required)
    //   - email: string (required, email format)
    //   - role: string (required, 'doctor', 'consultant', 'admin')
    //   - clinicType: string (optional, for consultants)
    //
    // Collection: bookings
    // Document ID: auto-generated
    // Fields:
    //   - patientId: string (required)
    //   - patientName: string (required)
    //   - patientPhone: string (required)
    //   - diagnosis: string (required)
    //   - clinicType: string (required)
    //   - reviewDate: string (required, ISO date)
    //   - status: string (required, 'pending', 'attended', 'no-show')
    //   - bookedBy: string (required, uid)
    //   - bookedAt: string (required, ISO date-time)
    //
    // ===============================================================

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        hardcodedAdmin(request.auth.token.get('email', '').lower(), request.auth.token.get('email_verified', false) == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'ceo'
        ))
      );
    }

    function hardcodedAdmin(email, verified) {
      return verified && email in ["godiimwas@gmail.com", "tumutumuclinicmanager@gmail.com", "ragnarkaladin@gmail.com"];
    }

    function isDoctor() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'doctor';
    }

    function isConsultant() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'consultant';
    }

    function isCEO() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'ceo';
    }

    function isCMO() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'cmo';
    }

    function isTheatre() {
      return isAuthenticated() && (
        request.auth.token.get('email', '').lower() == 'tumutumutheatre@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'theatre')
      );
    }

    function isWhitelisted(email, role) {
      return exists(/databases/$(database)/documents/whitelisted_emails/$(email.lower())) && 
             get(/databases/$(database)/documents/whitelisted_emails/$(email.lower())).data.get('role', '') == role;
    }

    // --- Domain Validators ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['doctor', 'consultant', 'admin', 'ceo', 'theatre', 'cmo'] &&
             (!('clinicType' in data) || data.clinicType in ['Pediatrics', 'Neuro', 'ENT', 'Surgical', 'Orthopedic', 'Gynae/Obs', 'MOPC']);
    }

    function isValidSurgicalCase(data) {
      return data.keys().hasAll(['patientName', 'patientNumber', 'diagnosis', 'procedure', 'department', 'surgeon', 'date', 'recordedBy', 'recordedByName', 'recordedAt', 'consentGiven']) &&
             data.patientName is string && data.patientName.size() > 0 && data.patientName.size() < 100 &&
             data.patientNumber is string && data.patientNumber.size() > 0 && data.patientNumber.size() < 20 &&
             data.diagnosis is string && data.diagnosis.size() > 0 && data.diagnosis.size() < 1000 &&
             data.procedure is string && data.procedure.size() > 0 && data.procedure.size() < 1000 &&
             data.department in ['General Surgery', 'Orthopedic', 'Urology', 'ENT', 'Neurosurgery', 'Plastic Surgery', 'Ophthalmology', 'OGD/Colonoscopy'] &&
             data.surgeon is string && data.surgeon.size() > 0 &&
             data.date is string &&
             data.recordedBy == request.auth.uid &&
             data.recordedByName is string &&
             data.consentGiven == true;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['patientId', 'patientName', 'patientPhone', 'diagnosis', 'clinicType', 'reviewDate', 'status', 'bookedBy', 'bookedAt', 'consentGiven']) &&
             data.patientName is string && data.patientName.size() > 0 && data.patientName.size() < 100 &&
             data.patientPhone is string && data.patientPhone.size() > 0 && data.patientPhone.size() < 20 &&
             data.diagnosis is string && data.diagnosis.size() > 0 && data.diagnosis.size() < 5000 &&
             data.clinicType in ['Pediatrics', 'Neuro', 'ENT', 'Surgical', 'Orthopedic', 'Gynae/Obs', 'MOPC'] &&
             data.status in ['pending', 'attended', 'no-show'] &&
             data.consentGiven == true;
    }

    // --- Rules ---

    match /users/{uid} {
      allow read, create, update: if isAuthenticated();
    }

    match /bookings/{bookingId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /patients/{patientId} {
      allow read, write: if isAuthenticated();
    }

    match /whitelisted_emails/{email} {
      allow read, write: if isAuthenticated();
    }

    match /marketing_messages/{messageId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; 
    }

    match /surgical_cases/{caseId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
